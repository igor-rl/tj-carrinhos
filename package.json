{
  "name": "carrinho-app",
  "version": "1.0.0",
  "description": "App web (PWA) para montar os carrinhos de literatura, do jeito que você já organiza no Figma: uma **Biblioteca** de banners/folhetos/brochuras/convites/livros/revistas, e **Carrinhos** agrupados por ocasião (Mercado Municipal, Ração, Finados...), cada um com \"Carrinho 1\", \"Carrinho 2\" etc.",
  "main": "app.js",
  "scripts": {
    "test": "echo \"Error: no test specified\" && exit 1",
    "build:css": "tailwindcss -i ./src/input.css -o ./styles.css --minify",
    "watch:css": "tailwindcss -i ./src/input.css -o ./styles.css --watch",
    "watch:server": "live-server --port=${PORT:-3000} --no-browser --wait=150 --ignore=node_modules,.git,src,.claude --watch=index.html,app.js,db.js,files.js,backup.js,styles.css,service-worker.js,manifest.json",
    "dev": "concurrently -k -n css,server \"npm:watch:css\" \"npm:watch:server\""
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/igor-rl/tj-carrinhos.git"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "type": "commonjs",
  "bugs": {
    "url": "https://github.com/igor-rl/tj-carrinhos/issues"
  },
  "homepage": "https://github.com/igor-rl/tj-carrinhos#readme",
  "devDependencies": {
    "@tailwindcss/cli": "^4.3.3",
    "concurrently": "^10.0.5",
    "live-server": "^1.2.2",
    "tailwindcss": "^4.3.3"
  }
}
